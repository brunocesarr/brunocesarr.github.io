---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="about" class="bg-paper px-6 py-24 text-body">
<div class="mx-auto max-w-5xl" data-reveal>
  <div class="text-center">
    <h2 data-reveal-item class="text-3xl font-semibold text-ink">Um pouco sobre mim</h2>
    <hr data-reveal-item class="mx-auto my-4 h-1 w-16 border-0 bg-accent" />
    <p  data-reveal-item class="italic text-body/70">"Live a life you will remember!"</p>
  </div>

  <div class="mt-14 grid items-center gap-8 md:grid-cols-2">
    <figure data-reveal-item class="overflow-hidden rounded-xl shadow-xl">
      <img src="/images/foto_perfil.jpg" alt="Retrato de Bruno César Silva"
           width="600" height="600" loading="lazy" decoding="async"
           class="aspect-square w-full object-cover" />
      <figcaption class="bg-paper py-4 text-center">
        <span class="block font-semibold text-ink">Bruno C. Silva</span>
        <span class="text-sm text-body/60">Developer</span>
      </figcaption>
    </figure>

    <div data-reveal-item class="space-y-4 leading-relaxed text-body/80">
      <p>{t('about.p1')}</p>
      <p>{t('about.p2')}</p>
      <p>{t('about.p3')}</p>
    </div>
  </div>
</div>
</section>
