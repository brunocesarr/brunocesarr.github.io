---
const socials = [
{ label: 'GitHub',    href: 'https://github.com/brunocesarr' },
{ label: 'LinkedIn',  href: 'https://www.linkedin.com/in/bruno-silva-9a155816b/' },
{ label: 'Instagram', href: 'https://www.instagram.com/bruno._.cesar/' },
{ label: 'E-mail',    href: 'mailto:brunoc.15@hotmail.com?subject=Entrar%20em%20Contato' },
];
---
<section id="contact" class="px-6 py-24">
<div class="mx-auto max-w-3xl text-center" data-reveal>
  <h2 data-reveal-item class="text-3xl font-semibold">Contatos</h2>
  <hr data-reveal-item class="mx-auto my-4 h-1 w-16 border-0 bg-accent" />

  <ul class="mt-10 flex flex-wrap justify-center gap-4">
    {socials.map(({ label, href }) => (
      <li data-reveal-item>
        <a href={href} target="_blank" rel="noopener noreferrer" aria-label={label}
           class="inline-flex items-center gap-2 rounded-full border border-white/15
                  px-5 py-2.5 text-sm transition-colors
                  hover:border-accent hover:text-accent-bright">
          {label}
        </a>
      </li>
    ))}
  </ul>
</div>
</section>