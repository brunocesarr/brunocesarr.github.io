---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
---
<footer class="border-t border-white/10 px-6 py-10 text-center text-sm text-muted">
<p>© {year} Bruno César Silva</p>
<a href="https://github.com/brunocesarr/brunocesarr.github.io"
   target="_blank" rel="noopener noreferrer"
   class="mt-2 inline-block transition-colors hover:text-accent-bright">
   {t('footer.source')}
</a>
</footer>