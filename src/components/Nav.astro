---
import { getLangFromUrl, useTranslations, getAltLang } from '../i18n/utils';
import { languages } from '../i18n/ui';
import { getRelativeLocaleUrl } from 'astro:i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const alt = getAltLang(lang);

const links = [
  { href: '#about', label: t('nav.about') },
  { href: '#projects', label: t('nav.projects') },
  { href: '#contact', label: t('nav.contact') },
];
---
<div id="nav-sentinel" aria-hidden="true"
     class="absolute top-0 h-[100px] w-full pointer-events-none"></div>

<nav id="mainNav"
     class="fixed inset-x-0 top-0 z-40 transition-all duration-300
            [&.is-scrolled]:bg-paper [&.is-scrolled]:shadow-lg">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href={getRelativeLocaleUrl(lang, '/')}
       class="border-l border-t border-[#555] px-[5px] py-px font-sans text-2xl
              text-paper transition-colors
              [.is-scrolled_&]:text-body [.is-scrolled_&]:hover:text-accent">
      DEV
    </a>

    <div class="flex items-center gap-6">
      <ul class="flex gap-6 text-sm uppercase tracking-wide">
        {links.map(({ href, label }) => (
          <li>
            <a href={href} data-spy
               class="text-paper transition-colors hover:text-accent-bright
                      [&.is-active]:text-accent-bright
                      [.is-scrolled_&]:text-body
                      [.is-scrolled_&]:hover:text-accent
                      [.is-scrolled_&.is-active]:text-accent">
              {label}
            </a>
          </li>
        ))}
      </ul>

      <a href={getRelativeLocaleUrl(alt, '/')}
         hreflang={alt === 'pt-br' ? 'pt-BR' : alt}
         aria-label={t('lang.switch')}
         class="rounded-full border border-white/25 px-3 py-1 text-xs uppercase
                tracking-wide text-paper transition-colors
                hover:border-accent hover:text-accent-bright
                [.is-scrolled_&]:border-body/30 [.is-scrolled_&]:text-body
                [.is-scrolled_&]:hover:text-accent">
        {alt === 'en' ? 'EN' : 'PT'}
      </a>
    </div>
  </div>
</nav>